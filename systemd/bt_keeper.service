[Unit]
Description=Bluetooth Major IV Keeper & PulseAudio
After=bluetooth.service sound.target
# Ограничивает busy-loop рестартов: без этого зацикленное падение сервиса
# каждые 5 секунд убивало бы pulseaudio на каждой попытке (см. bt_keeper.sh)
# и рвало звук во всех остальных процессах комплекса.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment=PULSE_RUNTIME_PATH=/run/user/0/pulse

# Право на планирование в реальном времени для PulseAudio.
#
# Зачем оно нужно: кодек A2DP считается в самом pulseaudio и обязан отдавать
# пакеты по часам гарнитуры, буфер синка — десятки миллисекунд. Под нагрузкой
# (распознавание, запись видео, кодирование звука) обычный SCHED_OTHER не
# успевает, буфер пустеет, и в наушнике это хруст с провалами — который легко
# списать на плохой bluetooth или севшие наушники.
#
# ЧЕСТНО О РЕЗУЛЬТАТЕ: на этой плате строка не помогает, и лимит здесь ни при
# чём. Хроника замеров 22.08.2026:
#   1. С --realtime --high-priority все потоки сервера идут TS с nice -11:
#      флаги парсятся, приоритет опускается, класс планирования не меняется.
#   2. После LimitRTPRIO=20 в /proc/<pid>/limits стоит не 20, а 9 — это
#      собственный дефолт pulseaudio (rlimit-rtprio = 9 в daemon.conf),
#      который он ставит себе сам. Девяти хватает с запасом: сервер просит
#      приоритет 5. То есть лимит стеной никогда и не был.
#   3. `chrt -r 5 true` под root отвечает "Operation not permitted". Отказ
#      идёт от ядра и касается любого процесса, а не только pulseaudio.
# Вывод: планирование в реальном времени на этом ядре недоступно в принципе,
# и добиваться его настройками юнита бессмысленно. Хруст лечится тем, что
# реально сработало, — nice -11 плюс снятая с платы лишняя работа (покадровое
# кодирование JPEG для веб-стрима убрано из main.cpp).
#
# Строка оставлена намеренно: вреда от неё нет, а если ядро когда-нибудь
# сменят на собранное с RT-политиками, право окажется уже выдано. Считать её
# работающей мерой нельзя — см. пункт 3.
LimitRTPRIO=20
ExecStart=/bin/bash /root/bt_keeper.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
