[Unit]
Description=OSRM routing server (Docker) for BlindNav
After=docker.service network.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/diplom-cpp/deploy/osrm
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# Сам контейнер поднимается docker-ом с restart:unless-stopped (см.
# docker-compose.yml) — этот юнит только гарантирует, что "docker compose up"
# выполнится один раз при загрузке системы, даже если контейнер ещё не создан
# (первый запуск после клонирования).

[Install]
WantedBy=multi-user.target
