[Unit]
Description=Voice Navigation Daemon
# osrm.service — не Requires: демон уже сам переживает недоступный OSRM
# (периодически предупреждает голосом, см. OSRM_FAILURE_WARN_EVERY в
# voice_nav_daemon.py), поэтому мягкий порядок запуска, а не жёсткая зависимость.
After=network.target bt_keeper.service osrm.service
# Ограничивает busy-loop рестартов (например, если отсутствует модель Vosk
# или файл адресов) — без RestartSec тут был systemd-дефолт ~100мс,
# что при отсутствующей зависимости давало рестарт-шторм.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/python3 -u /root/diplom-cpp/python/voice_nav_daemon.py
WorkingDirectory=/root/diplom-cpp/python
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
